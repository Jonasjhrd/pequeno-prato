{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // ⬇️ AQUI ESTÁ O SEGREDO: Base na raiz
    "baseUrl": ".", 
    "paths": {
      // ⬇️ MAPEAMENTO UNIVERSAL:
      // Isso diz: "Qualquer coisa que comece com @/, procure na raiz ./"
      // Isso resolve @/components, @/data, @/lib, @/hooks automagicamente.
      "@/*": ["./*"] 
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}