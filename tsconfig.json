{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // ESSENCIAL: Diz ao TypeScript que a raiz do projeto é o ponto de partida
    "baseUrl": ".", 
    "paths": {
      // ⬇️ CORREÇÃO FINAL E ISOLADA ⬇️
      // Foca APENAS nas pastas que estavam causando o erro de Path Alias.
      "@/components/*": ["./components/*"],
      "@/lib/*": ["./lib/*"]
      // O Next.js infere os caminhos de 'app' e 'hooks' automaticamente.
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}