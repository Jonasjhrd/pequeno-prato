{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // ⬇️ ESSENCIAL: Diz ao TypeScript para procurar tudo dentro de 'src'
    "baseUrl": "./src", 
    "paths": {
      // ⬇️ ESSENCIAL: Mantém o alias @/ apontando para o baseUrl (src)
      "@/*": ["./*"]
    }
  },
  // ⬇️ Incluir todos os arquivos TS/TSX dentro de 'src'
  "include": ["src/next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}