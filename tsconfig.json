{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // ⬇️ ESSENCIAL: Diz ao TypeScript que a raiz do projeto é o ponto de partida
    "baseUrl": ".", 
    "paths": {
      // ⬇️ CORREÇÃO FINAL: Mapeamento único e simplificado ⬇️
      // Este mapeamento engloba todas as pastas na raiz (app, components, lib, hooks)
      "@/*": ["./*"] 
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}