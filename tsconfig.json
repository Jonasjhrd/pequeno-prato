{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".", 
    "paths": {
      // ⬇️ Mapeamento Correto Baseado na Estrutura de Pastas ⬇️
      // Componentes e Lib (Na Raiz do Projeto)
      "@/components/*": ["./components/*"],
      "@/lib/*": ["./lib/*"],
      
      // Arquivos de App (Para globals.css, layout.tsx, etc.)
      "@/app/*": ["./app/*"],

      // O alias geral @/ aponta para a raiz
      "@/*": ["./*"] 
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}