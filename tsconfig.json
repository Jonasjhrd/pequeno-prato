{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      // ⬇️ MAPEAMENTO EXATO BASEADO NA SUA IMAGEM ⬇️
      
      // 1. Componentes (Resolve o erro do Footer)
      "@/components/*": ["./components/*"],
      
      // 2. Outras pastas da raiz que vi na imagem
      "@/lib/*": ["./lib/*"],
      "@/hooks/*": ["./hooks/*"],
      "@/styles/*": ["./styles/*"],
      
      // 3. App (Onde você disse que estão as recipes)
      "@/app/*": ["./app/*"],

      // 4. TRUQUE PARA O DATA:
      // Se o código chama "@/data/recipes", vamos mandar ele procurar em "./app/recipes"
      "@/data/*": ["./app/*"],

      // 5. Fallback geral (Rede de segurança)
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}